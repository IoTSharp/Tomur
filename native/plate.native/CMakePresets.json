{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/..",
      "description": "Install the Tomur plate bridge and caller-supplied runtime dependencies without bundling model weights.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "TOMUR_HYPERLPR3_ROOT": "$env{TOMUR_HYPERLPR3_ROOT}",
        "TOMUR_HYPERLPR3_INCLUDE_DIR": "$env{TOMUR_HYPERLPR3_INCLUDE_DIR}",
        "TOMUR_HYPERLPR3_LIBRARY": "$env{TOMUR_HYPERLPR3_LIBRARY}",
        "TOMUR_HYPERLPR3_RUNTIME_LIBRARY": "$env{TOMUR_HYPERLPR3_RUNTIME_LIBRARY}",
        "TOMUR_MNN_RUNTIME_LIBRARY": "$env{TOMUR_MNN_RUNTIME_LIBRARY}",
        "TOMUR_PLATE_RUNTIME_DEPENDENCIES": "$env{TOMUR_PLATE_RUNTIME_DEPENDENCIES}",
        "OpenCV_DIR": "$env{OpenCV_DIR}"
      }
    },
    {
      "name": "windows-x64",
      "displayName": "Windows x64 (Release)",
      "inherits": "base",
      "generator": "Visual Studio 18 2026",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      }
    },
    {
      "name": "linux-x64",
      "displayName": "Linux x64 (Release)",
      "inherits": "base",
      "generator": "Unix Makefiles",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "linux-arm64",
      "displayName": "Linux arm64 (Release)",
      "inherits": "base",
      "generator": "Unix Makefiles",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Linux",
        "CMAKE_SYSTEM_PROCESSOR": "aarch64",
        "CMAKE_C_COMPILER": "aarch64-linux-gnu-gcc",
        "CMAKE_CXX_COMPILER": "aarch64-linux-gnu-g++"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x64",
      "configurePreset": "windows-x64",
      "configuration": "Release"
    },
    {
      "name": "linux-x64",
      "configurePreset": "linux-x64"
    },
    {
      "name": "linux-arm64",
      "configurePreset": "linux-arm64"
    }
  ]
}
