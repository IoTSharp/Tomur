<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Tomur</AssemblyName>
    <RootNamespace>Tomur</RootNamespace>
    <OutputType>Exe</OutputType>
    <Version>0.5.0-r5</Version>
    <AssemblyVersion>0.5.0.0</AssemblyVersion>
    <FileVersion>0.5.0.0</FileVersion>
    <InformationalVersion>0.5.0-r5</InformationalVersion>
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
    <RuntimeIdentifiers>win-x64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <SpaRoot>..\web\</SpaRoot>
    <TomurBuildWebAssets Condition="'$(TomurBuildWebAssets)' == ''">true</TomurBuildWebAssets>
    <TomurReleaseProfile Condition="'$(TomurReleaseProfile)' == '' and '$(PublishAot)' == 'true'">native-aot-audit</TomurReleaseProfile>
    <TomurReleaseProfile Condition="'$(TomurReleaseProfile)' == ''">self-contained-single-file</TomurReleaseProfile>
    <DefineConstants Condition="'$(PublishAot)' == 'true'">$(DefineConstants);TOMUR_NATIVE_AOT</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>false</IncludeAllContentForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\providers\Abstractions\Tomur.Providers.Abstractions.csproj" />
    <ProjectReference Include="..\providers\Glm\Tomur.Providers.Glm.csproj" />
    <ProjectReference Include="..\providers\Olmoe\Tomur.Providers.Olmoe.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.5" />
    <PackageReference Include="Microsoft.AspNetCore.SpaServices.Extensions" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.5" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.9.0" />
    <PackageReference Include="Microsoft.Agents.AI" Version="1.19.0" />
    <PackageReference Include="Microsoft.Agents.AI.Workflows" Version="1.19.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.16.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.16.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="wwwroot\**\*" />
    <EmbeddedResource Include="wwwroot\**\*" />
    <Content Include="..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\NOTICE" Link="NOTICE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\native\bundle.manifest.json" Link="native\bundle.manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\native\runtimes\**\*" Link="native\runtimes\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <WebSourceFiles Include="$(SpaRoot)src\**\*" />
    <WebSourceFiles Include="$(SpaRoot)public\**\*" />
    <WebSourceFiles Include="$(SpaRoot)index.html" />
    <WebSourceFiles Include="$(SpaRoot)package.json" />
    <WebSourceFiles Include="$(SpaRoot)package-lock.json" />
    <WebSourceFiles Include="$(SpaRoot)tsconfig*.json" />
    <WebSourceFiles Include="$(SpaRoot)vite.config.ts" />
  </ItemGroup>

  <Target
    Name="RestoreWebAssets"
    Condition="'$(TomurBuildWebAssets)' == 'true' and '$(DesignTimeBuild)' != 'true'"
    Inputs="$(SpaRoot)package-lock.json"
    Outputs="$(SpaRoot)node_modules\.package-lock.json">
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm ci --no-audit --no-fund" />
  </Target>

  <Target
    Name="BuildWebAssets"
    BeforeTargets="PrepareForBuild"
    DependsOnTargets="RestoreWebAssets"
    Condition="'$(TomurBuildWebAssets)' == 'true' and '$(DesignTimeBuild)' != 'true'"
    Inputs="@(WebSourceFiles)"
    Outputs="$(MSBuildProjectDirectory)\wwwroot\index.html">
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm run build" />
  </Target>

  <Target
    Name="IncludeWebAssets"
    BeforeTargets="CreateManifestResourceNames"
    DependsOnTargets="BuildWebAssets"
    Condition="'$(TomurBuildWebAssets)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <Error
      Condition="!Exists('$(MSBuildProjectDirectory)\wwwroot\index.html')"
      Text="Tomur Web assets were not generated. Run npm ci and npm run build in the web directory, or inspect the preceding Web build error." />
    <ItemGroup>
      <EmbeddedResource Remove="wwwroot\**\*" />
      <EmbeddedResource Include="wwwroot\**\*" />
    </ItemGroup>
  </Target>
</Project>
